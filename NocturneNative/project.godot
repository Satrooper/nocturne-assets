config_version=5

[application]
config/name="Nocturne: Black Rain — V7"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/project_settings_override="user://display_override.cfg"
config/description="A native third-person action prototype. Five contracts, mission interactions, touch controls and five boss encounters."
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/ios/allow_high_refresh_rate=false
window/ios/hide_home_indicator=true
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.ios="metal"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=0
shading/overrides/force_vertex_shading.mobile=false
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=0
scaling_3d/scale=0.75
viewport/hdr_2d=false
occlusion_culling/use_occlusion_culling=true
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false
